# Reuse the pinned runtime dependencies; package this fork's complete application source.
FROM git.subcult.tv/subculture-collective/hasanara-api@sha256:5cf777c0b94670241154121162a0b9ed459afd2e1151f4c53b5636955f53c563
ARG GIT_COMMIT=unknown
ENV GIT_COMMIT=${GIT_COMMIT}
COPY app /app/app
COPY worker/__init__.py worker/formatter.py worker/state_model.py /app/worker/
COPY alembic /app/alembic
COPY scripts /app/scripts
RUN python3 -m compileall -q /app/app
